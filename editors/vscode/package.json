{
  "name": "dap-watch",
  "displayName": "dap-watch",
  "description": "Hot-reload debugging — automatically rebuilds and restarts your debug session on file changes",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "debuggers": [
      {
        "type": "dap-watch",
        "configurationAttributes": {
          "launch": {
            "required": [
              "adapter"
            ],
            "properties": {
              "adapter": {
                "type": "string",
                "description": "The debug adapter type to proxy (e.g. codelldb, delve)"
              },
              "port": {
                "type": "number",
                "description": "Port dap-watch is listening on",
                "default": 6969
              },
              "program": {
                "type": "string",
                "description": "Path to the program to debug"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Program arguments"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory"
              },
              "env": {
                "type": "object",
                "description": "Environment variables"
              },
              "adapterConfig": {
                "type": "object",
                "description": "Additional adapter-specific configuration"
              }
            }
          },
          "attach": {
            "required": [
              "adapter"
            ],
            "properties": {
              "adapter": {
                "type": "string",
                "description": "The debug adapter type to proxy (e.g. codelldb, delve)"
              },
              "port": {
                "type": "number",
                "description": "Port dap-watch is listening on",
                "default": 6969
              },
              "adapterConfig": {
                "type": "object",
                "description": "Additional adapter-specific configuration"
              }
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
